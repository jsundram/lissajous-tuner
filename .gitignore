# Keep PII and machine junk out of the repo.
# Any roster / contacts / phone-number data belongs in a private Google Sheet, pulled at runtime —
# NEVER committed. A noindex page is still public to anyone with the URL.
*roster*.json
*private*
.DS_Store
node_modules/
__pycache__/

# Claude Code: track .claude/settings.json (team hooks), ignore the ephemeral working dir.
.claude/.cc-writes/

# scripts/shot.mjs default output — a working artifact, never committed
shot.png
*.f32

# Instrument recordings. Deliberately NOT committed: they are audio of a person playing, and this
# repo is public. They are real ground truth and worth keeping locally — scripts/analyze-recording.mjs
# replays any of them through the shipping DSP — but a future session cannot assume they exist.
recordings/

# Screen recordings of the app under test. Useful for a session, far too big for the repo — a
# 35 s capture is 64 MB. Run them through scripts/analyze-recording.mjs and commit the finding,
# not the video.
*.mp4
*.mov
